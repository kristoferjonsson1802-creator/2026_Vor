<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Matseðill</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <%- include('partials/header.ejs') %>

    <main>
        <section>
            <div class="grid">
                <div class="card">
                    <h2>Mánudagur</h2>
                    <img src="img/Wrap.jpg" alt="Wrap" class="img-main">
                    <p>Vefja með grilluðum kjúllingum og grænmeti</p>
                </div>
                <div class="card">
                    <h2>Þriðjudagur</h2>
                    <img src="img/Spaghetti.jpg" alt="Spaghetti" class="img-main">
                    <p>Hakk og spagettí</p>
                </div>
                <div class="card">
                    <h2>Miðvikudagur</h2>
                    <img src="img/Soup.jpg" alt="Soup" class="img-main">
                    <p>Íslensk kjöt súpa</p>
                </div>
                <div class="card">
                    <h2>Fimmtudagur</h2>
                    <img src="img/Chicken.jpg" alt="Chicken" class="img-main">
                    <p>Ofn grillaður kjúlingur</p>
                </div>
                <div class="card">
                    <h2>Föstudagur</h2>
                    <img src="img/Pizza.jpg" alt="Pizza" class="img-main">
                    <p>Peperoni Pizza</p>
                </div>
            </div>
        </section>
    </main>

    <%- include('partials/footer.ejs') %>

</body>
</html>