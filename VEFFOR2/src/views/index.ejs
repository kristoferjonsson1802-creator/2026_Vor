<!DOCTYPE html>
<html lang="is">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Opium</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <%- include('partials/header') %>

  <main>
    
    <section class="text">
      <h3>Artists</h3>

      <div class="artist-grid">
        <% artists.forEach(artist => { %>
          <div class="artist-card">
            <h3><%= artist.title %></h3>

            <img src="<%= artist.image %>" alt="<%= artist.title %>">

            <a class="link" href="/artist/<%= artist.id %>">
              View artist
            </a>
          </div>
        <% }) %>
      </div>
    </section>

    <section class="text">
      <h3>Link to their music</h3>
      <a href="https://open.spotify.com/playlist/2e6efMiBY7WFnUTMyuDp14?si=a841badaa1924438" class="link">
        ♱OPIUM♱
      </a>
    </section>

  </main>

  <%- include('partials/footer') %>

</body>
</html>